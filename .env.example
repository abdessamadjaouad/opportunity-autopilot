# Copy to .env locally. Keep secrets in private files; never paste them into chat.
OA_PUBLIC_URL=http://127.0.0.1:8000
OA_PRODUCTION=false
OA_LIVE_SUBMISSIONS_ENABLED=false
OA_PAID_SERVICES_ENABLED=false
# OA_DATABASE_URL_FILE=/run/secrets/database_url
# OA_SECRET_KEY_FILE=/run/secrets/autopilot_key
# OA_OWNER_FILE=/run/secrets/owner.json
# OA_GOOGLE_CLIENT_ID=
# OA_GOOGLE_CLIENT_SECRET_FILE=/run/secrets/google_client_secret
# OA_GMAIL_QUERY=newer_than:30d -category:promotions
# OA_OPENAI_API_KEY_FILE=/run/secrets/openai_key
# OA_OPENAI_MODEL=choose-after-evaluation
# OA_SEARCH_API_KEY_FILE=/run/secrets/search_key
# OA_SEARCH_REQUEST_COST_CENTS=0
# OA_OPENAI_INPUT_CENTS_PER_MILLION=0
# OA_OPENAI_OUTPUT_CENTS_PER_MILLION=0
# OA_BROWSER_ADAPTER_REGISTRY=/run/secrets/reviewed-adapters.json
# OA_EMAIL_NOTIFICATIONS_ENABLED=false
# OA_GOOGLE_OAUTH_TESTING=true
# OA_BACKUP_KEY_FILE=/run/secrets/backup.key
# OA_BACKUP_DIRECTORY=/mnt/private-backups
